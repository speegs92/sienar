@namespace Sienar.Ui

@typeparam T where T : BlazorApp
@inject T App

<CascadingAuthenticationState>
	@foreach (var c in App.RouterAdjacentComponents)
	{
		<DynamicComponent Type="c"/>
	}

	<Router
		AppAssembly="_rootAssembly"
		AdditionalAssemblies="_routableAssemblies"
		NotFoundPage="App.NotFoundView">
		<Found Context="routeData">
			<CascadingValue Value="@routeData">
				<CascadingValue Value="@App">
					<SienarFound/>
				</CascadingValue>
			</CascadingValue>
		</Found>
	</Router>
</CascadingAuthenticationState>
