{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"types": [
			"vite/client"
		],
		"skipLibCheck": true,
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",
		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"baseUrl": ".",
		"paths": {
			"@sienar/utils": ["./src/Sienar.Plugins.Mvc/wwwsrc/utils/src/index.ts"],
			"@utils/*": ["./src/Sienar.Plugins.Mvc/wwwsrc/utils/src/*"],
			"@sienar/ui": ["./src/Sienar.Plugins.Mvc/wwwsrc/ui/src/index.ts"],
			"@ui/*": ["./src/Sienar.Plugins.Mvc/wwwsrc/ui/src/*"],
			"@sienar/plugins-core": ["./src/Sienar.Plugins.Mvc/wwwsrc/plugins-core/src/index.ts"],
			"@plugins-core/*": ["./src/Sienar.Plugins.Mvc/wwwsrc/plugins-core/src/*"],
			"@sienar/plugins-identity": ["./src/Sienar.Plugins.Identity/wwwsrc/index.ts"],
			"@plugins-identity/*": ["./src/Sienar.Plugins.Identity/wwwsrc/*"]
		}
	},
	"include": [
		"./playground/Template.RazorPages/wwwsrc"
	]
}
